# PULSE Server & VDC Engine Environment Configuration

# Server Environment: development | production | test
PULSE_ENV=development
PULSE_HOST=127.0.0.1
PULSE_PORT=8000
PULSE_DEBUG=false

# Security & Cryptography
# 32-byte hexadecimal secret key for HMAC token signing and KEK
PULSE_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Ed25519 server private key (Base64-encoded 32-byte raw seed)
PULSE_SERVER_ED25519_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Virtual Container Engine Execution Policy: LOW_CPU | BALANCED | PERFORMANCE
VDC_DEFAULT_POLICY=BALANCED

# Execution Backend: INLINE | DURABLE_WORKER | LOCAL
VDC_EXECUTION_BACKEND=INLINE

# Safety and Quota Limits
VDC_INLINE_MAX_DATASET_BYTES=268435456
VDC_INLINE_MAX_DURATION_SECONDS=120
VDC_MEMORY_RESERVE_BYTES=67108864

# Distributed State Fabric (Optional: leave empty to use in-memory store)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Persistent Storage Root (defaults to temporary directory in serverless)
VDC_STORAGE_ROOT=
